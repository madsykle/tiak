# Server Configuration
PORT=4697
HOST=0.0.0.0
DATA_ROOT=data
MONGODB_URI=mongodb://your-mongo-uri-here
MAX_CONCURRENT_DOWNLOADS=4
MAX_RETRY_COUNT=5

# CORS Configuration (comma-separated)
CORS_ORIGINS=https://your-app.vercel.app,http://localhost:3000,http://localhost:3001

# Authentication (disabled by default)
ENABLE_AUTH=false
JWT_SECRET=development-secret-key-change-in-production
JWT_EXPIRY_HOURS=24

# Security Settings
MAX_UPLOAD_SIZE=10485760  # 10MB
ENABLE_RATE_LIMITING=false
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
ENABLE_HTTPS_REDIRECT=false
SECURITY_HEADERS=true

# yt-dlp Configuration
YT_DLP_PYTHON=venv_python/bin/python
YT_DLP_BINARY=bin/yt-dlp

# Optional SOCKS/HTTP proxy routed only for Instagram URLs (e.g. socks5://your-proxy:port).
# Applies to both downloads and metadata backfill. Leave empty/unset to disable.
INSTAGRAM_PROXY=

# Logging
RUST_LOG=info
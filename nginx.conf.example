server {
    listen 80;
    listen [::]:80;
    server_name your-domain.com;

    # Go Backend API (served under /tiak/)
    location /tiak/ {
        proxy_pass http://localhost:4697/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        client_max_body_size 2G;
        client_body_timeout 300s;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # Video Streaming - CRITICAL: proxy_buffering off
    location /tiak/files/stream {
        proxy_pass http://localhost:4697/files/stream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Range $http_range;
        proxy_set_header If-Range $http_if_range;
        
        proxy_buffering off;
        proxy_cache off;
        
        client_max_body_size 2G;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # Thumbnails - cache for 1 day
    location /tiak/files/thumbnail {
        proxy_pass http://localhost:4697/files/thumbnail;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        
        proxy_cache_valid 200 1d;
        proxy_cache_valid 404 1m;
        add_header X-Cache-Status $upstream_cache_status;
    }

    # Health checks (no auth)
    location /tiak/health {
        proxy_pass http://localhost:4697/health;
        access_log off;
    }
    location /tiak/ready {
        proxy_pass http://localhost:4697/ready;
        access_log off;
    }
    location /tiak/metrics {
        proxy_pass http://localhost:4697/metrics;
        access_log off;
    }
}

